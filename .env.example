APP_NAME=SportBuddy
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=info

# ── PostgreSQL (Supabase) ──────────────────────────────────────
# Session pooler (IPv4). Host exacto en Supabase → Database → Connection string → Session
DB_CONNECTION=pgsql
DB_HOST=aws-0-eu-west-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.utcbtuvyggmbkvpukcnf
DB_PASSWORD=
DB_SSLMODE=require

# ── Desarrollo local rápido (recomendado) ─────────────────────
# Sustituye el bloque anterior por esto para evitar ~300 ms por query a Supabase:
# DB_CONNECTION=sqlite
# DB_DATABASE=/ruta/absoluta/a/database/database.sqlite
# (crea el archivo: touch database/database.sqlite && php artisan migrate --seed)

# ── Supabase API (solo si usas el SDK; nunca en el frontend el secret) ──
SUPABASE_URL=https://TU_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://TU_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=contacto@sportbuddy.test
MAIL_FROM_NAME="${APP_NAME}"

# Correo (importante):
# - Local: MAIL_MAILER=log → no envía; escribe en storage/logs/laravel.log
# - Producción: SMTP real (Resend, Mailgun, Postmark, SES, o SMTP de tu dominio)
# - Supabase NO envía el mail de la app (solo BD/Auth). Para Contactanos/verificación usa un proveedor SMTP/API.
# Ejemplo Resend SMTP:
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.resend.com
#   MAIL_PORT=587
#   MAIL_USERNAME=resend
#   MAIL_PASSWORD=re_xxxxx
#   MAIL_FROM_ADDRESS=noreply@tudominio.com
# AUTO_VERIFY_EMAIL=false obliga a verificar el correo tras registrarse
AUTO_VERIFY_EMAIL=false

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

OPENWEATHER_API_KEY=

TRUSTED_PROXIES=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"

# Usuarios de prueba (php artisan migrate:fresh --seed)
# Contraseña para todos: 12345678
# Admin: admin@gmail.com | Usuario: enrique@gmail.com
