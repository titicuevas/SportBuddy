# Copia estas variables en Railway → Service → Variables
# NO subas este archivo con valores reales a GitHub.
# Sustituye cada <...> por tu valor real en el panel de Railway.

APP_NAME=SportBuddy
APP_ENV=production
APP_DEBUG=false
APP_KEY=<ejecuta: php artisan key:generate --show>
APP_URL=<https://tu-proyecto.up.railway.app>
TRUSTED_PROXIES=*

DB_CONNECTION=pgsql
# Session pooler (IPv4) — Supabase → Database → Connection string → Session
DB_HOST=aws-0-eu-west-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.utcbtuvyggmbkvpukcnf
DB_PASSWORD=<Supabase → Settings → Database → Database password>
DB_SSLMODE=require

SESSION_DRIVER=cookie
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
LOG_CHANNEL=stack
LOG_LEVEL=info

AUTO_VERIFY_EMAIL=false

# SMTP real (Resend/Mailgun/Postmark/SES). Supabase no envía mail de la app.
MAIL_MAILER=smtp
MAIL_HOST=<smtp_host>
MAIL_PORT=587
MAIL_USERNAME=<smtp_user>
MAIL_PASSWORD=<smtp_password>
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=contacto@sportbuddy.es
MAIL_FROM_NAME=SportBuddy

PAYPAL_CLIENT_ID=<developer.paypal.com → Sandbox → Client ID>
PAYPAL_CLIENT_SECRET=<developer.paypal.com → Sandbox → Secret>
PAYPAL_MODE=sandbox

OPENWEATHER_API_KEY=<opcional>

VITE_APP_NAME=SportBuddy
